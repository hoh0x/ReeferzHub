    GunESP = false,
    TrapESP = false,
    RemoveTraps = false,
    RoleNotifyM = false,
    RoleNotifyS = false,
    GunNotify = false,
    RoundTimer = false,
    AutoGrabGun = false,
}

local Connections = {}
local function disconnect(name)
    if Connections[name] then
        pcall(function() Connections[name]:Disconnect() end)
        Connections[name] = nil
    end
end

-- Role data
local PlayerData = {}

do
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gameplay = remotes and (remotes:FindFirstChild("Gameplay") or remotes:FindFirstChild("Gameplay",true))
    local event = gameplay and gameplay:FindFirstChild("PlayerDataChanged")
    if event and event:IsA("RemoteEvent") then
        event.OnClientEvent:Connect(function(data)
            if type(data)=="table" then PlayerData=data end
        end)
    end
    local getPD = ReplicatedStorage:FindFirstChild("GetPlayerData",true)
    if getPD and typeof(getPD.InvokeServer)=="function" then
        pcall(function()
            local ok,res = pcall(function() return getPD:InvokeServer() end)
            if ok and type(res)=="table" then PlayerData=res end
        end)
    end
end

local function roleOf(p)
    if not p then return "Unknown" end
    if p.Backpack and p.Backpack:FindFirstChild("Knife") then return "Murderer" end
    if p.Character and p.Character:FindFirstChild("Knife") then return "Murderer" end
    if p.Backpack and p.Backpack:FindFirstChild("Gun") then return "Sheriff" end
    if p.Character and p.Character:FindFirstChild("Gun") then return "Sheriff" end
    local d = PlayerData[p.Name]
    if d then
        local r = d.Role or d.role
        if r == "Murderer" or r == "Sheriff" or r == "Hero" then return r end
    end
    return "Innocent"
end

local function roleColor(role)
    if role=="Murderer" then return PINK end
    if role=="Sheriff" then return BLUE end
    if role=="Hero" then return BLUE end
    return GREEN
end

local function updateRolePill()
    local r = roleOf(LocalPlayer)
    RolePill.Text = "ROLE  •  "..string.upper(r)
    RolePill.TextColor3 = roleColor(r)
    rps.Color = roleColor(r)
end

-- ESP
local Highlights = {}
local NameGuis = {}
local GunArtifacts = {}
local TrapArtifacts = {}

local function clearESP()
    for _,h in pairs(Highlights) do if h and h.Parent then h:Destroy() end end
    for _,g in pairs(NameGuis) do if g and g.Parent then g:Destroy() end end
    for _,a in pairs(GunArtifacts) do if a and a.Parent then a:Destroy() end end
    for _,a in pairs(TrapArtifacts) do if a and a.Parent then a:Destroy() end end
    table.clear(Highlights)
    table.clear(NameGuis)
    table.clear(GunArtifacts)
    table.clear(TrapArtifacts)
end

local function addPlayerESP(p)
    if p == LocalPlayer or not p.Character then return end
    local color = roleColor(roleOf(p))

    if State.PlayerESP then
        local h = Highlights[p]
        if not h or not h.Parent then
            h = Instance.new("Highlight")
            h.Name = "ReeferzESP"
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillTransparency = .62
            h.OutlineTransparency = .05
            h.Parent = p.Character
            Highlights[p] = h
        end
        h.FillColor = color
        h.OutlineColor = color
    end

    if State.ShowNames then
        local head = p.Character:FindFirstChild("Head")
        if head then
            local gui = NameGuis[p]
            if not gui or not gui.Parent then
                gui = Instance.new("BillboardGui")
                gui.Name = "ReeferzNameESP"
                gui.Size = UDim2.fromOffset(180,48)
                gui.StudsOffset = Vector3.new(0,2.8,0)
                gui.AlwaysOnTop = true
                gui.Parent = head

                local label = Instance.new("TextLabel")
                label.Name = "Label"
                label.Size = UDim2.fromScale(1,.55)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 12
                label.TextStrokeTransparency = .25
                label.Parent = gui

                local roleLabel = Instance.new("TextLabel")
                roleLabel.Name = "Role"
                roleLabel.Size = UDim2.fromScale(1,.45)
                roleLabel.Position = UDim2.fromScale(0,.55)
                roleLabel.BackgroundTransparency = 1
                roleLabel.Font = Enum.Font.GothamBold
                roleLabel.TextSize = 9
                roleLabel.TextStrokeTransparency = .3
                roleLabel.Parent = gui

                NameGuis[p] = gui
            end
            local label = gui:FindFirstChild("Label")
            local roleLabel = gui:FindFirstChild("Role")
            local r = roleOf(p)
            if label then
                label.Text = p.DisplayName
                label.TextColor3 = roleColor(r)
            end
            if roleLabel then
                roleLabel.Text = r
                roleLabel.TextColor3 = roleColor(r)
            end
        end
    end
end

local function refreshESP()
    if not State.PlayerESP and not State.ShowNames and not State.GunESP and not State.TrapESP then
        clearESP()
        return
    end
    for _,p in ipairs(Players:GetPlayers()) do addPlayerESP(p) end
end

-- Player page
section(PlayerPage,"MOVEMENT","Personal movement controls")

toggle(PlayerPage,"WalkSpeed","Enable custom walk speed",function(v)
    State.WalkSpeedEnabled=v
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = v and State.WalkSpeed or 16 end
end)

slider(PlayerPage,"WalkSpeed",16,100,16,function(v)
    State.WalkSpeed=v
    if State.WalkSpeedEnabled then
        local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed=v end
    end
end)

toggle(PlayerPage,"JumpPower","Enable custom jump power",function(v)
    State.JumpPowerEnabled=v
    local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.UseJumpPower=true
        hum.JumpPower=v and State.JumpPower or 50
    end
end)

slider(PlayerPage,"JumpPower",50,150,50,function(v)
    State.JumpPower=v
    if State.JumpPowerEnabled then
        local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.UseJumpPower=true hum.JumpPower=v end
    end
end)

toggle(PlayerPage,"Noclip","Disable your character's collisions",function(v)
    State.Noclip=v
    disconnect("Noclip")
    if v then
        Connections.Noclip=RunService.Stepped:Connect(function()
            local c=LocalPlayer.Character
            if c then
                for _,p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide=false end
                end
            end
        end)
    end
end)

toggle(PlayerPage,"Infinite Jump","Jump while airborne",function(v)
    State.InfiniteJump=v
    disconnect("InfiniteJump")
    if v then
        Connections.InfiniteJump=UserInputService.JumpRequest:Connect(function()
            local hum=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end)

section(PlayerPage,"PROTECTION","Defensive utilities")

toggle(PlayerPage,"Anti-Fling","Reduce character physics interference",function(v)
    State.AntiFling=v
    disconnect("AntiFling")
    if v then
        Connections.AntiFling=RunService.Stepped:Connect(function()
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=LocalPlayer and p.Character then
                    for _,part in ipairs(p.Character:GetChildren()) do
                        if part:IsA("BasePart") and part.Name=="HumanoidRootPart" then
                            part.AssemblyLinearVelocity=Vector3.zero
                            part.AssemblyAngularVelocity=Vector3.zero
                        end
                    end
                end
            end
        end)
    end
end)

toggle(PlayerPage,"Anti-AFK","Keep the utility enabled while idle",function(v)
    -- Roblox's official idle event is intentionally not used to synthesize input.
    State.AntiAFK=v
end)

