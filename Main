--==================================================
-- BACKGROUND ANIMATION
--==================================================

task.spawn(function()

	while ScreenGui.Parent do

		if Config.Background.Enabled then

			local Tween1 = TweenService:Create(
				Glow1,
				TweenInfo.new(
					Config.Background.Speed,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(0.2, 0, 0.15, 0),
					Size = UDim2.fromOffset(550, 550)
				}
			)

			local Tween2 = TweenService:Create(
				Glow2,
				TweenInfo.new(
					Config.Background.Speed + 1,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(0.5, 0, 0.45, 0),
					Size = UDim2.fromOffset(500, 500)
				}
			)

			local Tween3 = TweenService:Create(
				Glow3,
				TweenInfo.new(
					Config.Background.Speed + 0.5,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(0.1, 0, 0.55, 0)
				}
			)

			Tween1:Play()
			Tween2:Play()
			Tween3:Play()

			task.wait(Config.Background.Speed)

			local Reverse1 = TweenService:Create(
				Glow1,
				TweenInfo.new(
					Config.Background.Speed,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(-0.3, 0, -0.3, 0),
					Size = UDim2.fromOffset(450, 450)
				}
			)

			local Reverse2 = TweenService:Create(
				Glow2,
				TweenInfo.new(
					Config.Background.Speed + 1,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(0.75, 0, 0.7, 0),
					Size = UDim2.fromOffset(400, 400)
				}
			)

			local Reverse3 = TweenService:Create(
				Glow3,
				TweenInfo.new(
					Config.Background.Speed + 0.5,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{
					Position = UDim2.new(0.4, 0, 0.1, 0)
				}
			)

			Reverse1:Play()
			Reverse2:Play()
			Reverse3:Play()

			task.wait(Config.Background.Speed)

		else

			task.wait(0.25)

		end

	end

end)

