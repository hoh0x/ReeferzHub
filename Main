--==================================================
-- DRAG FUNCTION
--==================================================

local function MakeDraggable(Object, callback)

	local Dragging = false
	local DragStart = nil
	local StartPosition = nil

	Object.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true
			DragStart = Input.Position
			StartPosition = Object.Position

		end

	end)

	Object.InputEnded:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = false

		end

	end)

	UserInputService.InputChanged:Connect(function(Input)

		if not Dragging then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseMovement
			and Input.UserInputType ~= Enum.UserInputType.Touch then

			return

		end

		local Delta = Input.Position - DragStart

		local NewPosition = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,

			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)

		Object.Position = NewPosition

		if callback then
			callback(NewPosition)
		end

	end)

end

--==================================================
-- DRAG NORMAL HUB
-- ONLY THE HEADER DRAGS IT
--==================================================

MakeDraggable(DragArea, function(NewPosition)

	Main.Position = NewPosition
	MinimizedButton.Position = NewPosition

end)

--==================================================
-- DRAG MINIMIZED CIRCLE
--==================================================

MakeDraggable(MinimizedButton, function(NewPosition)

	Main.Position = NewPosition

end)

--==================================================
-- MINIMIZE
--==================================================

local IsMinimized = false

Minimize.MouseButton1Click:Connect(function()

	if IsMinimized then
		return
	end

	IsMinimized = true

	-- Save position
	MinimizedButton.Position = Main.Position

	-- Shrink menu
	local ShrinkTween = TweenService:Create(
		Main,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		),
		{
			Size = UDim2.fromOffset(0, 0)
		}
	)

	ShrinkTween:Play()

	ShrinkTween.Completed:Wait()

	Main.Visible = false

	-- Show circle
	MinimizedButton.Visible = true

	MinimizedButton.Size = UDim2.fromOffset(0, 0)

	TweenService:Create(
		MinimizedButton,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(
				Config.Window.MinimizedSize,
				Config.Window.MinimizedSize
			)
		}
	):Play()

end)

--==================================================
-- RESTORE
--==================================================

MinimizedButton.MouseButton1Click:Connect(function()

	if not IsMinimized then
		return
	end

	IsMinimized = false

	-- Keep menu at circle position
	Main.Position = MinimizedButton.Position

	local CircleTween = TweenService:Create(
		MinimizedButton,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.In
		),
		{
			Size = UDim2.fromOffset(0, 0)
		}
	)

	CircleTween:Play()

	CircleTween.Completed:Wait()

	MinimizedButton.Visible = false

	-- Restore menu
	Main.Visible = true

	Main.Size = UDim2.fromOffset(0, 0)

	TweenService:Create(
		Main,
		TweenInfo.new(
			0.4,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Size = UDim2.fromOffset(
				Config.Window.Width,
				Config.Window.Height
			)
		}
	):Play()

end)

--==================================================
-- CLOSE
--==================================================

Close.MouseButton1Click:Connect(function()

	local CloseTween = TweenService:Create(
		Main,
		TweenInfo.new(0.25),
		{
			Size = UDim2.fromOffset(0, 0)
		}
	)

	CloseTween:Play()

	CloseTween.Completed:Wait()

	ScreenGui:Destroy()

end)

--==================================================
-- OPEN ANIMATION
--==================================================

Main.Size = UDim2.fromOffset(0, 0)

TweenService:Create(
	Main,
	TweenInfo.new(
		0.5,
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	),
	{
		Size = UDim2.fromOffset(
			Config.Window.Width,
			Config.Window.Height
		)
	}
):Play()

print("REEFERZ HUB LOADED SUCCESSFULLY")
