    State.PlayerESP=v
    refreshESP()
end)

toggle(ESPPage,"Player Names","Display names and role under the name",function(v)
    State.ShowNames=v
    refreshESP()
end)

toggle(ESPPage,"Dropped Gun ESP","Highlight the dropped sheriff gun",function(v)
    State.GunESP=v
    refreshESP()
end)

toggle(ESPPage,"Trap ESP","Highlight visible trap objects",function(v)
    State.TrapESP=v
    refreshESP()
end)

toggle(ESPPage,"Remove Traps","Hide visible trap objects locally",function(v)
    State.RemoveTraps=v
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if string.find(string.lower(obj.Name),"trap") then
            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = v and 1 or 0
            end
        end
    end
end)

-- World ESP heartbeat
Connections.ESP=RunService.Heartbeat:Connect(function()
    if State.PlayerESP or State.ShowNames then
        for _,p in ipairs(Players:GetPlayers()) do
            addPlayerESP(p)
        end
    end

    if State.GunESP then
        for _,obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name=="GunDrop" and obj:IsA("BasePart") then
                local h=GunArtifacts[obj]
                if not h then
                    h=Instance.new("Highlight")
                    h.Name="ReeferzGunESP"
                    h.FillColor=BLUE
                    h.OutlineColor=BLUE
                    h.FillTransparency=.35
                    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent=obj
                    GunArtifacts[obj]=h
                end
            end
        end
    end

    if State.TrapESP then
        for _,obj in ipairs(Workspace:GetDescendants()) do
            if string.find(string.lower(obj.Name),"trap") and obj:IsA("BasePart") then
                local h=TrapArtifacts[obj]
                if not h then
                    h=Instance.new("Highlight")
                    h.Name="ReeferzTrapESP"
                    h.FillColor=RED
                    h.OutlineColor=RED
                    h.FillTransparency=.45
                    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent=obj
                    TrapArtifacts[obj]=h
                end
            end
        end
    end
end)

-- Teleport
section(TeleportPage,"SERVER","Server controls")
action(TeleportPage,"↻   Rejoin Current Server",function()
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId,game.JobId,LocalPlayer)
    end)
end)

action(TeleportPage,"↗   Server Hop",function()
    local ok,data=pcall(function()
        return HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
        ))
    end)
    if ok and data and data.data then
        for _,server in ipairs(data.data) do
            if server.id~=game.JobId and server.playing<server.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId,server.id,LocalPlayer)
                return
            end
        end
    end
end)

section(TeleportPage,"MAP","Quick locations")
local function getMap()
    for _,o in ipairs(Workspace:GetChildren()) do
        if o:FindFirstChild("CoinContainer") and o:FindFirstChild("Spawns") then return o end
    end
end

action(TeleportPage,"⌖   Teleport To Map Spawn",function()
    local map=getMap()
    local spawns=map and map:FindFirstChild("Spawns")
    local char=LocalPlayer.Character
    if char and spawns then
        local list={}
        for _,v in ipairs(spawns:GetChildren()) do
            if v:IsA("BasePart") then table.insert(list,v) end
        end
        if #list>0 then char:PivotTo(list[math.random(#list)].CFrame*CFrame.new(0,5,0)) end
    end
end)

action(TeleportPage,"⌂   Teleport To Lobby",function()
    local char=LocalPlayer.Character
    if not char then return end
    for _,obj in ipairs(Workspace:GetChildren()) do
        local lobby=obj:FindFirstChild("Lobby") or (obj.Name:lower()=="lobby" and obj)
        if lobby then
            local spawns=lobby:FindFirstChild("Spawns")
            if spawns then
                for _,v in ipairs(spawns:GetChildren()) do
                    if v:IsA("BasePart") then char:PivotTo(v.CFrame*CFrame.new(0,5,0)); return end
                end
            end
        end
    end
end)

section(TeleportPage,"PLAYER TELEPORT","Teleport to a selected player")
local playerButtons={}

local PlayerList=Instance.new("Frame")
PlayerList.Size=UDim2.new(1,0,0,150)
PlayerList.BackgroundColor3=CARD
PlayerList.BorderSizePixel=0
PlayerList.Parent=TeleportPage
local plc=Instance.new("UICorner"); plc.CornerRadius=UDim.new(0,11); plc.Parent=PlayerList

local PlayerScroll=Instance.new("ScrollingFrame")
PlayerScroll.Size=UDim2.new(1,-10,1,-10)
PlayerScroll.Position=UDim2.fromOffset(5,5)
PlayerScroll.BackgroundTransparency=1
PlayerScroll.BorderSizePixel=0
PlayerScroll.ScrollBarThickness=2
PlayerScroll.ScrollBarImageColor3=PINK
PlayerScroll.Parent=PlayerList

local playerLayout=Instance.new("UIListLayout")
playerLayout.Padding=UDim.new(0,4)
playerLayout.Parent=PlayerScroll
PlayerScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y

local selectedPlayer=nil
local function rebuildPlayers()
    for _,b in ipairs(playerButtons) do if b then b:Destroy() end end
    table.clear(playerButtons)
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer then
            local b=Instance.new("TextButton")
            b.Size=UDim2.new(1,-4,0,31)
            b.BackgroundColor3=CARD2
            b.BorderSizePixel=0
            b.Text=p.DisplayName.."  @"..p.Name
            b.TextColor3=WHITE
            b.TextSize=10
            b.Font=Enum.Font.GothamMedium
            b.AutoButtonColor=false
            b.Parent=PlayerScroll
            local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,8); c.Parent=b
            b.MouseButton1Click:Connect(function()
                selectedPlayer=p
                for _,x in ipairs(playerButtons) do
                    if x.Parent then x.BackgroundColor3=CARD2 end
                end
                b.BackgroundColor3=Color3.fromRGB(52,20,42)
            end)
            table.insert(playerButtons,b)
        end
    end
end
Players.PlayerAdded:Connect(function() task.wait(.2); rebuildPlayers() end)
Players.PlayerRemoving:Connect(function() task.wait(.2); rebuildPlayers() end)
rebuildPlayers()

action(TeleportPage,"Teleport To Selected Player",function()
    if selectedPlayer and selectedPlayer.Character and LocalPlayer.Character then
        local root=selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then LocalPlayer.Character:PivotTo(root.CFrame*CFrame.new(0,3,0)) end
    end
end)

-- Round
section(RoundPage,"ROUND STATUS","Live MM2 information")

local TimerCard=Instance.new("Frame")
TimerCard.Size=UDim2.new(1,0,0,74)
TimerCard.BackgroundColor3=CARD
TimerCard.BorderSizePixel=0
TimerCard.Parent=RoundPage
local tcc=Instance.new("UICorner"); tcc.CornerRadius=UDim.new(0,12); tcc.Parent=TimerCard

local TimerTitle=Instance.new("TextLabel")
TimerTitle.Size=UDim2.new(1,-24,0,20)
TimerTitle.Position=UDim2.fromOffset(12,9)
TimerTitle.BackgroundTransparency=1
TimerTitle.Text="ROUND TIMER"
TimerTitle.TextColor3=MUTED
TimerTitle.TextSize=9
TimerTitle.Font=Enum.Font.GothamBold
TimerTitle.TextXAlignment=Enum.TextXAlignment.Left
TimerTitle.Parent=TimerCard

local TimerValue=Instance.new("TextLabel")
TimerValue.Size=UDim2.new(1,-24,0,38)
TimerValue.Position=UDim2.fromOffset(12,28)
TimerValue.BackgroundTransparency=1
TimerValue.Text="--:--"
TimerValue.TextColor3=PINK_SOFT
TimerValue.TextSize=25
TimerValue.Font=Enum.Font.GothamBold
TimerValue.TextXAlignment=Enum.TextXAlignment.Left
TimerValue.Parent=TimerCard

toggle(RoundPage,"Round Timer","Show live timer in the hub",function(v)
    State.RoundTimer=v
end)

toggle(RoundPage,"Murderer Notification","Notify when the murderer is detected",function(v)
    State.RoleNotifyM=v
end)

toggle(RoundPage,"Sheriff Notification","Notify when the sheriff is detected",function(v)
    State.RoleNotifyS=v
end)

toggle(RoundPage,"Gun Drop Notification","Notify when the gun is dropped",function(v)
    State.GunNotify=v
end)

local lastMurderer,lastSheriff,lastGun=false,false,false
local lastGunObj=nil

task.spawn(function()
    while ScreenGui.Parent do
        updateRolePill()

        if State.RoundTimer then
            local ok,timeLeft=pcall(function()
                return ReplicatedStorage.Remotes.Extras.GetTimer:InvokeServer()
            end)
            if ok and type(timeLeft)=="number" and timeLeft>=0 then
                TimerValue.Text=string.format("%02d:%02d",math.floor(timeLeft/60),math.floor(timeLeft%60))
            else
                TimerValue.Text="--:--"
            end
        else
            TimerValue.Text="--:--"
        end

        local m=nil
        local s=nil
        for _,p in ipairs(Players:GetPlayers()) do
            local r=roleOf(p)
            if r=="Murderer" then m=p end
            if r=="Sheriff" then s=p end
        end

        if State.RoleNotifyM and m and not lastMurderer then
            notify("Murderer Detected",m.Name,5)
        end
        if State.RoleNotifyS and s and not lastSheriff then
            notify("Sheriff Detected",s.Name,5)
        end
        lastMurderer=m~=nil
        lastSheriff=s~=nil

        local gun=Workspace:FindFirstChild("GunDrop",true)
        if State.GunNotify and gun and gun~=lastGunObj then
            notify("Gun Dropped","The sheriff gun is on the map.",5)
        end
        lastGunObj=gun

        task.wait(1)
    end
end)

