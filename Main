--==================================================
-- TABS
--==================================================

local Tabs = {}

local function CreateTab(name)

	local Tab = Create("Frame", {
		Name = name,

		Size = UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,

		Visible = false,

		ZIndex = 20,

		Parent = Content
	})

	Tabs[name] = Tab

	return Tab
end

local function SwitchTab(name)

	for TabName, Tab in pairs(Tabs) do
		Tab.Visible = TabName == name
	end

	for _, Button in ipairs(Sidebar:GetChildren()) do

		if Button:IsA("TextButton") then

			if Button.Name == name then
				Button.BackgroundColor3 = Config.Theme.Main
			else
				Button.BackgroundColor3 = Config.Theme.Panel
			end

		end

	end
end

local function CreateTabButton(name, icon)

	local Button = Create("TextButton", {
		Name = name,

		Size = UDim2.new(1, -20, 0, 45),

		BackgroundColor3 = Config.Theme.Panel,

		Text = icon .. "  " .. name,

		TextColor3 = Config.Theme.Text,

		TextSize = 13,

		Font = Enum.Font.GothamSemibold,

		AutoButtonColor = false,

		ZIndex = 21,

		Parent = Sidebar
	})

	AddCorner(Button, 8)

	Button.MouseButton1Click:Connect(function()
		SwitchTab(name)
	end)

	return Button
end

--==================================================
-- SECTION CREATOR
--==================================================

local function CreateSection(parent, title)

	local Section = Create("Frame", {
		Name = title .. "Section",

		Size = UDim2.new(1, -10, 0, 35),

		BackgroundTransparency = 1,

		ZIndex = 21,

		Parent = parent
	})

	Create("TextLabel", {
		Size = UDim2.fromScale(1, 1),

		BackgroundTransparency = 1,

		Text = string.upper(title),

		TextColor3 = Config.Theme.Main,

		TextSize = 12,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 22,

		Parent = Section
	})

	return Section
end

--==================================================
-- TOGGLE CREATOR
--==================================================

local function CreateToggle(parent, title, description, callback)

	local Holder = Create("Frame", {

		Name = title .. "Toggle",

		Size = UDim2.new(1, -10, 0, 65),

		BackgroundColor3 = Config.Theme.Panel,

		BorderSizePixel = 0,

		ZIndex = 21,

		Parent = parent
	})

	AddCorner(Holder, 9)
	AddStroke(Holder, Config.Theme.Main, 1, 0.8)

	Create("TextLabel", {

		Size = UDim2.new(1, -80, 0, 25),

		Position = UDim2.fromOffset(15, 8),

		BackgroundTransparency = 1,

		Text = title,

		TextColor3 = Config.Theme.Text,

		TextSize = 14,

		Font = Enum.Font.GothamBold,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 22,

		Parent = Holder
	})

	Create("TextLabel", {

		Size = UDim2.new(1, -80, 0, 20),

		Position = UDim2.fromOffset(15, 34),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = Config.Theme.SubText,

		TextSize = 10,

		Font = Enum.Font.Gotham,

		TextXAlignment = Enum.TextXAlignment.Left,

		ZIndex = 22,

		Parent = Holder
	})

	local Switch = Create("TextButton", {

		Size = UDim2.fromOffset(50, 28),

		Position = UDim2.new(1, -65, 0.5, -14),

		BackgroundColor3 = Config.Theme.Off,

		Text = "",

		AutoButtonColor = false,

		ZIndex = 23,

		Parent = Holder
	})

	AddCorner(Switch, 20)

	local Knob = Create("Frame", {

		Size = UDim2.fromOffset(20, 20),

		Position = UDim2.fromOffset(4, 4),

		BackgroundColor3 = Color3.fromRGB(160, 120, 160),

		BorderSizePixel = 0,

		ZIndex = 24,

		Parent = Switch
	})

	AddCorner(Knob, 20)

	local Enabled = false

	Switch.MouseButton1Click:Connect(function()

		Enabled = not Enabled

		if Enabled then

			TweenService:Create(
				Switch,
				TweenInfo.new(0.2),
				{
					BackgroundColor3 = Config.Theme.Main
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(0.2),
				{
					Position = UDim2.new(1, -24, 0, 4),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				}
			):Play()

		else

			TweenService:Create(
				Switch,
				TweenInfo.new(0.2),
				{
					BackgroundColor3 = Config.Theme.Off
				}
			):Play()

			TweenService:Create(
				Knob,
				TweenInfo.new(0.2),
				{
					Position = UDim2.fromOffset(4, 4),
					BackgroundColor3 = Color3.fromRGB(160, 120, 160)
				}
			):Play()

		end

		-- INDIVIDUAL FEATURE CALLBACK
		callback(Enabled)

	end)

	return Holder
end

