local Pages = {}
local Tabs = {}

local function makePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.fromScale(1,1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = PINK
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new()
    page.Visible = false
    page.Parent = PagesHolder

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0,2)
    padding.PaddingRight = UDim.new(0,4)
    padding.PaddingBottom = UDim.new(0,4)
    padding.Parent = page

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0,7)
    list.Parent = page

    Pages[name] = page
    return page
end

local function makeTab(name, icon, order)
    local tab = Instance.new("TextButton")
    tab.Name = name.."Tab"
    tab.LayoutOrder = order
    tab.Size = UDim2.new(1,0,0,40)
    tab.BackgroundColor3 = CARD
    tab.BackgroundTransparency = .35
    tab.BorderSizePixel = 0
    tab.Text = "  "..icon.."   "..name
    tab.TextColor3 = MUTED
    tab.TextSize = 11
    tab.Font = Enum.Font.GothamBold
    tab.TextXAlignment = Enum.TextXAlignment.Left
    tab.AutoButtonColor = false
    tab.Parent = Sidebar

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,10)
    c.Parent = tab

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.fromOffset(3,18)
    indicator.Position = UDim2.new(0,0,.5,-9)
    indicator.BackgroundColor3 = PINK
    indicator.BackgroundTransparency = 1
    indicator.BorderSizePixel = 0
    indicator.Parent = tab

    local ic = Instance.new("UICorner")
    ic.CornerRadius = UDim.new(1,0)
    ic.Parent = indicator

    Tabs[name] = {button=tab, indicator=indicator}
    return tab
end

local function showPage(name)
    for n,p in pairs(Pages) do p.Visible = n == name end
    for n,t in pairs(Tabs) do
        local active = n == name
        TweenService:Create(t.button,TweenInfo.new(.16),{
            BackgroundColor3 = active and Color3.fromRGB(52,20,42) or CARD,
            BackgroundTransparency = active and .05 or .35,
            TextColor3 = active and WHITE or MUTED
        }):Play()
        TweenService:Create(t.indicator,TweenInfo.new(.16),{
            BackgroundTransparency = active and 0 or 1
        }):Play()
    end
end

local PlayerPage = makePage("Player")
local ESPPage = makePage("ESP")
local TeleportPage = makePage("Teleport")
local RoundPage = makePage("Round")
local UtilityPage = makePage("Utility")

makeTab("Player","●",1).MouseButton1Click:Connect(function() showPage("Player") end)
makeTab("ESP","◎",2).MouseButton1Click:Connect(function() showPage("ESP") end)
makeTab("Teleport","↗",3).MouseButton1Click:Connect(function() showPage("Teleport") end)
makeTab("Round","◷",4).MouseButton1Click:Connect(function() showPage("Round") end)
makeTab("Utility","⚙",5).MouseButton1Click:Connect(function() showPage("Utility") end)

