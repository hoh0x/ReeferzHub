-- Character refresh
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(.5)
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.UseJumpPower=true
        hum.WalkSpeed=State.WalkSpeedEnabled and State.WalkSpeed or 16
        hum.JumpPower=State.JumpPowerEnabled and State.JumpPower or 50
    end
    if State.Noclip then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end
    task.wait(.5)
    refreshESP()
end)

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(.5)
        refreshESP()
    end)
end)

-- Clean up artifacts when players leave
Players.PlayerRemoving:Connect(function(p)
    if Highlights[p] then Highlights[p]:Destroy() end
    if NameGuis[p] then NameGuis[p]:Destroy() end
    Highlights[p]=nil
    NameGuis[p]=nil
end)

